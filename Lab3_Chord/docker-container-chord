FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY src/go.mod ./

RUN go mod download

COPY src/ ./

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o /chord .

FROM alpine:latest

RUN apk --no-cache add ca-certificates

RUN addgroup -g 1000 chord && \
    adduser -D -u 1000 -G chord chord

WORKDIR /app

COPY --from=builder /chord /app/chord

RUN chown -R chord:chord /app

USER chord

EXPOSE 4000

ENTRYPOINT ["/app/chord"]

CMD ["-a", "0.0.0.0", "-p", "4000", "--ts", "3000", "--tff", "1000", "--tcp", "3000", "-r", "3"]
